# Homeframe environment example. Copy to .env for local development.
# Never commit a real .env file or a real Home Assistant token.

# --- Homeframe Runtime (npm start) ---------------------------------------
# The runtime keeps the Home Assistant credential on the server and only
# sends states and semantic discovery data to screens. This is the preferred
# way to connect a real home. Leave both unset to run without Home Assistant.
HOMEFRAME_HA_URL=http://homeassistant.local:8123
HOMEFRAME_HA_TOKEN=

# Where installation dashboards are stored. Defaults to ~/.homeframe.
# HOMEFRAME_DATA_DIR=/var/lib/homeframe

# Path to the framework checkout (schemas and card catalog). Defaults to cwd.
# HOMEFRAME_ROOT=/path/to/homeframe

# Runtime listen address. Defaults to 0.0.0.0:4173.
# HOMEFRAME_HOST=0.0.0.0
# HOMEFRAME_PORT=4173

# --- Vite development only (npm run dev) ---------------------------------
# Anything prefixed VITE_ is embedded in the browser build and visible to
# anyone who can load the page. Use a short-lived development token only.
# VITE_HA_URL=http://homeassistant.local:8123
# VITE_HA_TOKEN=
