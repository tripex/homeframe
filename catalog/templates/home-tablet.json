{
  "id": "home-tablet",
  "displayName": "Home tablet",
  "description": "Wall tablet home screen: side navigation, a hero picture of the house with up to two cameras beneath it, a status column (locks, climate, forecast, agenda or vacuum, and live energy flow when the home has solar or a grid meter) and a row of the most useful rooms.",
  "aiSummary": "Use for a 10\" landscape wall tablet that should feel like the front page of the house rather than a grid of devices.",
  "profile": "tablet-10",
  "navigation": {
    "style": "side",
    "people": "person[]"
  },
  "regions": [
    {
      "id": "hero",
      "x": 0,
      "w": 8,
      "stack": [
        {
          "instanceId": "home-scene",
          "card": "home-scene",
          "h": 7,
          "bindings": {
            "sun": "sun",
            "weather": "weather",
            "lock": "lock[]",
            "light": "light[]",
            "climate": "climate[]"
          }
        }
      ]
    },
    {
      "id": "status",
      "x": 8,
      "w": 4,
      "rows": 10,
      "stack": [
        {
          "instanceId": "lock-status",
          "card": "security",
          "h": 1,
          "priority": 5,
          "requires": [
            "lock",
            "alarm",
            "garage"
          ],
          "bindings": {
            "lock": "lock[]",
            "alarm": "alarm[]",
            "garage": "garage[]"
          }
        },
        {
          "instanceId": "climate-overview",
          "card": "climate",
          "h": 2,
          "priority": 1,
          "requires": [
            "climate"
          ],
          "bindings": {
            "climate": "climate[]"
          }
        },
        {
          "instanceId": "forecast",
          "card": "weather-forecast",
          "h": 2,
          "priority": 3,
          "requires": [
            "weather"
          ],
          "bindings": {
            "weather": "weather"
          }
        },
        {
          "instanceId": "agenda",
          "card": "agenda",
          "h": 2,
          "standIns": {
            "source": "appliances",
            "card": "appliance",
            "instanceId": "appliance",
            "max": 3
          },
          "priority": 2,
          "grow": 5,
          "requires": [
            "calendar"
          ],
          "bindings": {
            "calendar": "calendar[]"
          },
          "otherwise": [
            {
              "instanceId": "vacuum",
              "card": "vacuum",
              "requires": [
                "vacuum"
              ],
              "bindings": {
                "vacuum": "vacuum"
              }
            },
            {
              "instanceId": "presence",
              "card": "presence",
              "requires": [
                "person"
              ],
              "bindings": {
                "person": "person[]"
              }
            },
            {
              "instanceId": "agenda",
              "card": "agenda",
              "bindings": {
                "calendar": "calendar[]"
              }
            }
          ]
        },
        {
          "instanceId": "energy-flow",
          "card": "energy-flow",
          "h": 5,
          "priority": 4,
          "requires": [
            "solar_power",
            "grid_power"
          ],
          "bindings": {
            "solar_power": "solar_power",
            "grid_power": "grid_power",
            "battery_power": "battery_power",
            "battery_level": "battery_level",
            "ev_power": "ev_power",
            "power": "power",
            "energy": "energy",
            "price": "price"
          }
        }
      ]
    },
    {
      "id": "camera",
      "card": "camera",
      "w": 4,
      "h": 3,
      "max": 2,
      "fill": true,
      "x": 0,
      "span": 8,
      "below": "hero",
      "repeat": {
        "kind": "camera",
        "binding": "camera"
      }
    },
    {
      "id": "room",
      "card": "room",
      "w": 3,
      "h": 2,
      "max": 4,
      "fill": true,
      "repeat": {
        "areas": true
      },
      "bindings": {
        "temperature": "temperature",
        "humidity": "humidity",
        "light": "light[]",
        "climate": "climate"
      }
    }
  ]
}
